{
  "compilerOptions": {
    /* 1. Target Environment */
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"],

    /* 2. The "Clarity" Module Strategy */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": false,

    /* 3. Strictness & Safety */
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,

    /* 4. Project Layout */
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true
  },
  "include": ["src/**/*"]
}
